{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singsenochian.github.io/Runa/schemas/arkfire-world-profile.schema.json",
  "title": "Hearthgate Arkfire World Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "name",
    "profile_kind",
    "version",
    "status",
    "identity",
    "layers",
    "phases",
    "safety",
    "change_control"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 3 },
    "profile_kind": { "enum": ["world", "signal-protocol"] },
    "world": { "type": ["string", "null"] },
    "world_slug": { "type": ["string", "null"] },
    "version": { "type": "string" },
    "status": { "enum": ["seed", "calibration", "review", "stable", "retired", "blocked"] },
    "route": { "type": "string" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "shape", "intention", "arrival_signature", "return_signature"],
      "properties": {
        "tone": { "type": "string" },
        "shape": { "type": "string" },
        "intention": { "type": "string" },
        "arrival_signature": { "type": "string" },
        "return_signature": { "type": "string" },
        "palette": { "type": "array", "items": { "type": "string" } },
        "canon_sources": { "type": "array", "items": { "type": "string" } },
        "must_avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "master_clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "sync_mode": { "enum": ["locked", "mixed", "free"] },
        "macro_cycle_seconds": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": {
            "enum": [
              "established-science",
              "active-research",
              "speculative-theory",
              "symbolic-canon",
              "subjective-intention",
              "implementation-task",
              "evidence-backed-finding"
            ]
          },
          "text": { "type": "string" },
          "source_language": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "phases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" }
      ]
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "layer_overrides": { "type": "object" }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_master_gain_db", "maximum_master_gain_db", "fade_seconds", "headphones_required", "automatic_start_allowed"],
      "properties": {
        "default_master_gain_db": { "type": "number", "maximum": 0 },
        "maximum_master_gain_db": { "type": "number", "maximum": 0 },
        "maximum_duration_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "fade_seconds": { "type": "number", "minimum": 0.1 },
        "headphones_required": { "type": "boolean" },
        "automatic_start_allowed": { "const": false },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "change_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_changes_allowed", "change_one_variable_at_a_time", "approval_required"],
      "properties": {
        "automatic_changes_allowed": { "const": false },
        "change_one_variable_at_a_time": { "type": "boolean" },
        "approval_required": { "type": "boolean" },
        "calibration_assumptions": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "role", "gain_db", "enabled_by_default", "signal", "routing", "phase_continuous", "evidence_label", "collision_policy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string" },
        "type": { "enum": ["true-binaural", "isochronic", "tone", "pad", "noise", "cue", "haptic-reference"] },
        "role": { "type": "string" },
        "gain_db": { "type": "number", "maximum": 0 },
        "enabled_by_default": { "type": "boolean" },
        "signal": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "waveform": { "enum": ["sine", "triangle", "sawtooth", "square"] },
            "frequency_hz": { "type": "number", "minimum": 0 },
            "left_hz": { "type": "number", "exclusiveMinimum": 0 },
            "right_hz": { "type": "number", "exclusiveMinimum": 0 },
            "beat_hz": { "type": "number", "exclusiveMinimum": 0 },
            "noise_type": { "enum": ["pink", "white"] },
            "filter": { "type": "object" }
          }
        },
        "modulation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": { "enum": ["tremolo", "isochronic", "filter-sweep", "stereo-drift", "macro-envelope"] },
            "rate_hz": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "minimum": 0, "maximum": 1 },
            "phase_degrees": { "type": "number" }
          }
        },
        "routing": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["protected-stereo", "center", "left-bias", "right-bias", "stereo-drift", "haptic-only"] },
            "pan": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "phase_continuous": { "type": "boolean" },
        "symbolic_meaning": { "type": "string" },
        "experiential_intention": { "type": "string" },
        "evidence_label": {
          "enum": [
            "established-science",
            "active-research",
            "speculative-theory",
            "symbolic-canon",
            "subjective-intention",
            "implementation-task",
            "evidence-backed-finding"
          ]
        },
        "collision_policy": {
          "enum": [
            "none",
            "intentional-shared-source",
            "intentional-harmonic",
            "phase-locked",
            "gain-separated",
            "moved-to-harmonic",
            "masking-risk-accepted",
            "must-fix"
          ]
        },
        "accessibility_notes": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "true-binaural" } } },
          "then": {
            "properties": {
              "signal": { "required": ["left_hz", "right_hz", "beat_hz"] },
              "routing": { "properties": { "mode": { "const": "protected-stereo" } } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "haptic-reference" } } },
          "then": {
            "properties": {
              "routing": { "properties": { "mode": { "const": "haptic-only" } } }
            }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "duration_seconds", "purpose", "layer_states"],
      "properties": {
        "id": { "enum": ["baseline", "vestibule", "arrival", "immersion", "return"] },
        "label": { "type": "string" },
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "purpose": { "type": "string" },
        "layer_states": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": { "type": "boolean" },
              "gain_db": { "type": "number", "maximum": 0 }
            }
          }
        }
      }
    }
  }
}
